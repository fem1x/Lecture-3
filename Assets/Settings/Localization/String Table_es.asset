  - m_Id: 7370033339555840
    m_Localized: Fullpack
    m_Metadata:
      m_Items: []
  - m_Id: 7370033385693184
    m_Localized: "Tr\xEDada & Duplete"
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288273
    m_Localized: "Domin\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288274
    m_Localized: Permite formar una <style=combo>Secuencia</style> con 4 dados en vez de 5.
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288275
    m_Localized: Jigsaw
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288276
