    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000123
    m_Localized: 'PRECIO:'
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000124
    m_Localized: "Dado n.\xBA {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000135
    m_Localized: "Elige o desmonta un amuleto. La cinta se cerrar\xE1 despu\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000136
    m_Localized: "Usa <sprite name=\"repair_token\"> para reparar dados da\xF1ados y reducir el <style=wear>Desgaste</style>."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000137
    m_Localized: "Mejora una cara para obtener <style=points>Puntos</style> extra permanentes. Cada mejora del dado cuesta m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000138
    m_Localized: "Por recursos restantes:\n\u2022 Cada {throwsPerToken} <color=#FFB18D><sprite name=\"throw_counter\" tint=1></color> \u2192 +1 <color=#FFB28D><sprite name=\"repair_token\" tint=1></color>\n\u2022 Cada {rerollsPerToken} <color=#FFB18D><sprite name=\"reroll_counter\" tint=1></color> \u2192 +1 <color=#FFB28D><sprite name=\"repair_token\" tint=1></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000139
    m_Localized: "L\xEDmite de FPS"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000140
    m_Localized: "Sin l\xEDmite"
    m_Metadata:
      m_Items: []
