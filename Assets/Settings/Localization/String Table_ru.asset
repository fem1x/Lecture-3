      m_Items: []
  - m_Id: 418204264288256
    m_Localized: "\u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u0438\u0437
      \u2264 {maxDicesThreshold} \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u043D\u0435
      \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u043A\u0443\u0431\u0438\u043A\u0430\u043C
      <style=cracks>\u0422\u0440\u0435\u0449\u0438\u043D</style>"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288257
    m_Localized: Cassette Tape
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288258
    m_Localized: "\u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F <style=combo>\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0430</style>
      \u0434\u0430\u0451\u0442 <style=xmult>{xMultiplierPerStep} X-Mult</style> \u0437\u0430
      \u043A\u0430\u0436\u0434\u0443\u044E \u0435\u0434\u0438\u043D\u0438\u0446\u0443
      <style=wear>\u0418\u0437\u043D\u043E\u0441\u0430</style> \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0445
      \u043A\u0443\u0431\u043E\u0432"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288259
    m_Localized: Heart-Shaped Box
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288260
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0439
      \u043A\u0443\u0431\u0438\u043A \u0441 <style=cracks>\u0422\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438</style>
      \u0434\u0430\u0451\u0442 <style=mult>+{bonusMultiplier} Mult</style>"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288261
    m_Localized: Hourglass
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288262
    m_Localized: "\u0414\u0430\u0451\u0442 <style=xmult>{xMultiplier} X-Mult</style>,
      \u0435\u0441\u043B\u0438 \u0432 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0435\u0441\u0442\u044C
      <style=die>1</style> \u0438 <style=die>6</style>"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288263
    m_Localized: Lucky Dime
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288264
    m_Localized: "\u041A\u0443\u0431\u0438\u043A\u0438 \u0441\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C
      <style=die>{immuneValue}</style> \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 <style=cracks>\u0422\u0440\u0435\u0449\u0438\u043D</style>"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288265
    m_Localized: Porcelain
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288266
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u0430\u044F
      <style=die>{targetValue}</style> \u0434\u0430\u0451\u0442 <style=points>+{bonusPoints}
      Points</style> \u0438 <style=xmult>{xMultiplier} X-Mult</style>, \u043D\u043E
      \u0434\u0430\u0451\u0442 \u043A\u0443\u0431\u0438\u043A\u0443 <style=wear>+1
      \u0418\u0437\u043D\u043E\u0441</style>"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288267
    m_Localized: Safety Pin
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288268
    m_Localized: "\u0428\u0430\u043D\u0441 <style=chance>{saveChance:0%}</style>
