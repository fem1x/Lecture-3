      m_Items: []
  - m_Id: 13400000000000124
    m_Localized: "\u041A\u0443\u0431\u0438\u043A #{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000135
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0434\u0438\u043D \u0447\u0430\u0440\u043C \u0438\u043B\u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0438 \u0435\u0433\u043E. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u043D\u0432\u0435\u0439\u0435\u0440 \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000136
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 <sprite name=\"repair_token\">, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0435 \u043A\u0443\u0431\u0438\u043A\u0438 \u0438 \u0441\u043D\u0438\u0437\u0438\u0442\u044C <style=wear>\u0418\u0437\u043D\u043E\u0441</style>."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000137
    m_Localized: "\u0417\u0430\u043A\u0430\u043B\u0438 \u0433\u0440\u0430\u043D\u044C: \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439 \u0431\u043E\u043D\u0443\u0441 \u043A <style=points>\u043E\u0447\u043A\u0430\u043C</style>. \u041A\u0430\u0436\u0434\u0430\u044F \u0437\u0430\u043A\u0430\u043B\u043A\u0430 \u043A\u0443\u0431\u0438\u043A\u0430 \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000138
    m_Localized: "\u0417\u0430 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0440\u0435\u0441\u0443\u0440\u0441\u044B:\n\u2022 \u041A\u0430\u0436\u0434\u044B\u0435 {throwsPerToken} <color=#FFB18D><sprite name=\"throw_counter\" tint=1></color> \u2192 +1 <color=#FFB28D><sprite name=\"repair_token\" tint=1></color>\n\u2022 \u041A\u0430\u0436\u0434\u044B\u0435 {rerollsPerToken} <color=#FFB18D><sprite name=\"reroll_counter\" tint=1></color> \u2192 +1 <color=#FFB28D><sprite name=\"repair_token\" tint=1></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000139
