  - m_Id: 418204264288256
    m_Localized: "\u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u0438\u0437 \u2264 {maxDicesThreshold} \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u043D\u0435 \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u043A\u0443\u0431\u0438\u043A\u0430\u043C <style=cracks>\u0422\u0440\u0435\u0449\u0438\u043D</style>"
