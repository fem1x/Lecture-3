      m_Items: []
  - m_Id: 418204264288288
    m_Localized: "\u0414\u0430\u0451\u0442 <style=xmult>{xMultiplier} X-Mult</style> \u0437\u0430 <style=combo>\u0422\u0440\u0438\u0430\u0434\u0443</style>, <style=combo>\u041A\u0432\u0430\u0440\u0442\u0435\u0442</style> \u0438\u043B\u0438 <style=combo>\u0421\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C</style>. \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u043A\u0443\u0431\u0438\u043A \u0442\u0435\u0440\u044F\u0435\u0442 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288289
