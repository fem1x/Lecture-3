  - m_Id: 418204264288283
    m_Localized: Broken Mirror
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288284
    m_Localized: "\u0414\u0430\u0451\u0442 <style=points>+{bonusPoints} Points</style> \u0438 <style=xmult>{xMultiplier} X-Mult</style> \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u0443\u0431\u0438\u043A \u0441 1 \u0435\u0434. \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items:
      - rid: 420518586740899942
  - m_Id: 418204264288285
