    m_Localized: "\u0414\u0430\u0451\u0442 <style=xmult>{xMultiplier} X-Mult</style>, \u0435\u0441\u043B\u0438 \u0432 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0435\u0441\u0442\u044C <style=die>1</style> \u0438 <style=die>6</style>"
