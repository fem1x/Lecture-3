  - m_Id: 418204264288257
    m_Localized: Cassette Tape
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288258
    m_Localized: "\u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F <style=combo>\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0430</style> \u0434\u0430\u0451\u0442 <style=xmult>{xMultiplierPerStep} X-Mult</style> \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0435\u0434\u0438\u043D\u0438\u0446\u0443 <style=wear>\u0418\u0437\u043D\u043E\u0441\u0430</style> \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0445 \u043A\u0443\u0431\u043E\u0432"
