    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u0443\u0431\u0438\u043A \u0441 <style=cracks>\u0422\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438</style> \u0434\u0430\u0451\u0442 <style=mult>+{bonusMultiplier} Mult</style>"
