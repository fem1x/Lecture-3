  - m_Id: 418204264288282
    m_Localized: "\u0414\u0430\u0451\u0442 <style=xmult>{xMultiplier} X-Mult</style>, \u0435\u0441\u043B\u0438 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u0431\u0440\u043E\u0441\u043E\u0432"
