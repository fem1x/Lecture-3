    m_Metadata:
      m_Items: []
  - m_Id: 418204264288286
    m_Localized: "\u0414\u0430\u0451\u0442 <style=xmult>{xMultiplierPerStep} X-Mult</style> \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u043E\u0447\u043A\u043E \u0441\u0443\u043C\u043C\u044B \u0441\u0432\u0435\u0440\u0445 {sumThreshold} \u043F\u0440\u0438 \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 <style=combo>\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430</style>"
