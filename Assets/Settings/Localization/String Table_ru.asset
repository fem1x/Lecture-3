  - m_Id: 418204264288280
    m_Localized: "\u0414\u0430\u0451\u0442 <style=mult>+{evenBonusMultiplier} Mult</style> \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u0443\u0431\u0438\u043A, \u0435\u0441\u043B\u0438 \u0432\u0441\u0435 \u043E\u043D\u0438 \u0447\u0451\u0442\u043D\u044B\u0435. \u0414\u0430\u0451\u0442 <style=points>+{oddBonusPoints} Points</style> \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u0443\u0431\u0438\u043A, \u0435\u0441\u043B\u0438 \u0432\u0441\u0435 \u043E\u043D\u0438 \u043D\u0435\u0447\u0451\u0442\u043D\u044B\u0435"
