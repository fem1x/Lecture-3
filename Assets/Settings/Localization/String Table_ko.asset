    m_Metadata:
      m_Items: []
  - m_Id: 418204264288280
    m_Localized: "\uB0B8 \uC8FC\uC0AC\uC704\uAC00 \uBAA8\uB450 \uC9DD\uC218\uB77C\uBA74 \uB0B8 \uC8FC\uC0AC\uC704 \uD558\uB098\uB9C8\uB2E4<style=mult>+{evenBonusMultiplier} Mult</style> \uD68D\uB4DD. \uBAA8\uB450 \uD640\uC218\uB77C\uBA74 \uB0B8 \uC8FC\uC0AC\uC704 \uD558\uB098\uB9C8\uB2E4<style=points>+{oddBonusPoints} \uC810\uC218</style> \uD68D\uB4DD"
    m_Metadata:
      m_Items:
      - rid: 420518586740899945
  - m_Id: 418204264288281
    m_Localized: "\uB108\uC758 \uC0AC\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288282
