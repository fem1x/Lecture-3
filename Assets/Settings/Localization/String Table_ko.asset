  - m_Id: 13400000000000124
    m_Localized: "\uC8FC\uC0AC\uC704 #{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000135
    m_Localized: "\uBD80\uC801 \uD558\uB098\uB97C \uD68D\uB4DD\uD558\uAC70\uB098 \uBD84\uD574\uD558\uBA74 \uCEE8\uBCA0\uC774\uC5B4\uAC00 \uB2EB\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000136
    m_Localized: "<color=#FFB28D><sprite name=\"repair_token\" tint=1></color>\uC744 \uC0AC\uC6A9\uD574 \uC190\uC0C1\uB41C \uC8FC\uC0AC\uC704\uB97C \uC218\uB9AC\uD558\uACE0 <style=wear>\uB9C8\uBAA8</style>\uB97C \uC904\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000137
    m_Localized: "\uBA74\uC744 \uAC15\uD654\uD574 <style=points>\uC810\uC218</style>\uC5D0 \uC601\uAD6C \uBCF4\uB108\uC2A4\uB97C \uCD94\uAC00\uD569\uB2C8\uB2E4. \uAC19\uC740 \uC8FC\uC0AC\uC704\uB97C \uAC15\uD654\uD560\uC218\uB85D \uBE44\uC6A9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000138
    m_Localized: "\uB0A8\uC740 \uC790\uC6D0 \uBCF4\uC0C1:\n\u2022 {throwsPerToken} <color=#FFB18D><sprite name=\"throw_counter\" tint=1></color>\uB9C8\uB2E4 \u2192 +1 <color=#FFB28D><sprite name=\"repair_token\" tint=1></color>\n\u2022 {rerollsPerToken} <color=#FFB18D><sprite name=\"reroll_counter\" tint=1></color>\uB9C8\uB2E4 \u2192 +1 <color=#FFB28D><sprite name=\"repair_token\" tint=1></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 13400000000000139
    m_Localized: "FPS \uC81C\uD55C"
    m_Metadata:
      m_Items: []
