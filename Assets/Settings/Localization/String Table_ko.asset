    m_Localized: "\uB0B8 \uC8FC\uC0AC\uC704\uAC00 {maxDicesThreshold}\uAC1C \uC774\uD558\uB77C\uBA74 \uB0B8 \uC8FC\uC0AC\uC704\uC5D0<style=cracks>\uADE0\uC5F4</style>\uC774 \uC0DD\uAE30\uC9C0 \uC54A\uC74C"
