  - m_Id: 418204264288258
    m_Localized: "<style=combo>\uC5B8\uB354\uB85C\uB4DC</style>\uB97C \uB0B4\uBA74 \uB0B8 \uC8FC\uC0AC\uC704\uC758<style=wear>\uB9C8\uBAA8</style> 1\uB9C8\uB2E4<style=xmult>{xMultiplierPerStep} X-Mult</style> \uD68D\uB4DD"
    m_Metadata:
      m_Items:
      - rid: 420518586740899945
  - m_Id: 418204264288260
    m_Localized: "<style=cracks>\uADE0\uC5F4</style>\uC774 \uC788\uB294 \uB0B8 \uC8FC\uC0AC\uC704 \uD558\uB098\uB9C8\uB2E4<style=mult>+{bonusMultiplier} Mult</style> \uD68D\uB4DD"
