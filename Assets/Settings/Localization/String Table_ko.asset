  - m_Id: 418204264288264
    m_Localized: "\uB208\uC774 <style=die>{immuneValue}</style>\uC778 \uC8FC\uC0AC\uC704\uC5D0\uB294 <style=cracks>\uADE0\uC5F4</style>\uC774 \uC0DD\uAE30\uC9C0 \uC54A\uC73C\uBA70, \uB0BC \uB54C\uB9C8\uB2E4 <style=points>+{bonusPoints}\uC810</style>\uC744 \uC5BB\uC74C"
    m_Metadata:
      m_Items:
      - rid: 420518586740899945
  - m_Id: 418204264288266
    m_Localized: "\uB0B8<style=die>{targetValue}</style> \uD558\uB098\uB9C8\uB2E4<style=points>+{bonusPoints} \uC810\uC218</style>\uC640<style=xmult>{xMultiplier} X-Mult</style>\uB97C \uC5BB\uC9C0\uB9CC \uD574\uB2F9 \uC8FC\uC0AC\uC704\uC5D0<style=wear>+1 \uB9C8\uBAA8</style> \uCD94\uAC00"
    m_Metadata:
      m_Items:
      - rid: 420518586740899945
  - m_Id: 418204264288268
    m_Localized: "<style=chance>{saveChance:0%}</style> \uD655\uB960\uB85C \uC8FC\uC0AC\uC704\uC758<style=wear>\uB9C8\uBAA8</style>\uB97C \uB9C9\uACE0 \uBAA8\uB4E0<style=cracks>\uADE0\uC5F4</style> \uC81C\uAC70"
