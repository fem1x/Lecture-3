    m_Metadata:
      m_Items: []
  - m_Id: 418204264288286
    m_Localized: "<style=combo>\uC624\uBC84\uB85C\uB4DC</style>\uB97C \uB0BC \uB54C \uB208\uC758 \uD569\uC774 {sumThreshold}\uC744 1 \uCD08\uACFC\uD560 \uB54C\uB9C8\uB2E4<style=xmult>{xMultiplierPerStep} X-Mult</style> \uD68D\uB4DD"
    m_Metadata:
