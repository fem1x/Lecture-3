      m_Items: []
  - m_Id: 418204264288284
    m_Localized: "\uB0A8\uC740 \uB0B4\uAD6C\uB3C4\uAC00 1\uC778 \uB0B8 \uC8FC\uC0AC\uC704 \uD558\uB098\uB9C8\uB2E4<style=points>+{bonusPoints} \uC810\uC218</style>\uC640<style=xmult>{xMultiplier} X-Mult</style> \uD68D\uB4DD"
