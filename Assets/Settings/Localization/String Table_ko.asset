  - m_Id: 418204264288287
    m_Localized: "\uC18C\uB9AC\uAD7D\uC1E0"
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288288
    m_Localized: "<style=combo>\uD2B8\uB77C\uC774\uC5B4\uB4DC</style>, <style=combo>\uCFFC\uB4DC</style> \uB610\uB294<style=combo>\uC2F1\uADE4\uB798\uB9AC\uD2F0</style>\uB97C \uB0B4\uBA74<style=xmult>{xMultiplier} X-Mult</style> \uD68D\uB4DD. \uBB34\uC791\uC704 \uC8FC\uC0AC\uC704 \uD558\uB098\uB9CC \uB0B4\uAD6C\uB3C4 \uAC10\uC18C"
    m_Metadata:
