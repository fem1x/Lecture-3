    m_Localized: "\uB0B8 \uC8FC\uC0AC\uC704\uC758 \uB208\uC774 \uBAA8\uB450 \uB2E4\uB974\uBA74<style=xmult>{xMultiplier} X-Mult</style> \uD68D\uB4DD"
