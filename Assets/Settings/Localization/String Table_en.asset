  - m_Id: 418204264288256
    m_Localized: "Played dice do not gain Cracks if \u2264 {maxDicesThreshold} dice
      are played"
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288258
    m_Localized: Gives {xMultiplierPerStep} X-Mult for each Wear on played dice if
      combination is Underload
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288260
    m_Localized: Gives +{bonusMultiplier} Mult for each played die with Cracks
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288262
    m_Localized: Gives {xMultiplier} X-Mult if played dice contain both a 1 and a
      6
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288264
    m_Localized: Dice with value {immuneValue} never gain Cracks
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288266
    m_Localized: Gives +{bonusPoints} Points and {xMultiplier} X-Mult for each played
      {targetValue}, but adds +1 Wear to the die
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288268
    m_Localized: '{saveChance:0%} chance to prevent Wear and remove all Cracks from
      the die'
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288270
    m_Localized: "Gives {xMultiplier} X-Mult if \u2264 {maxDicesThreshold} dice are
      played"
    m_Metadata:
      m_Items: []
  - m_Id: 418204264288272
    m_Localized: Gives {xMultiplier} X-Mult if all played dice are Intact
