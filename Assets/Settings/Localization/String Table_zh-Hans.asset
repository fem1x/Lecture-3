    m_Localized: "\u6253\u51FA<style=combo>\u4F4E\u8F7D</style>\u65F6\uFF0C\u6253\u51FA\u7684\u9AB0\u5B50\u6BCF\u6709 1 \u70B9<style=wear>\u78E8\u635F</style>\uFF0C\u7ED9\u4E88<style=xmult>{xMultiplierPerStep} X-Mult</style>"
